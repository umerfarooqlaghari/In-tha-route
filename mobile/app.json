{
  "expo": {
    "name": "In Tha Route",
    "slug": "in-tha-route",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intharoute",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.in-tha-route.delivery",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.intharoute.delivery",
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "In Tha Route uses the camera to scan order receipts and photograph driver documents.",
          "photosPermission": "In Tha Route lets you choose a receipt or document photo from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "In Tha Route shows your position on the map and offers you orders near you while you are online.",
          "locationAlwaysAndWhenInUsePermission": "While you are online or on a delivery, In Tha Route keeps sharing your position when the phone is locked, so restaurants know when you will arrive and you get offers near you.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E5484D",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c652bd8d-756e-40d5-b122-ea9eed7ccee1"
      }
    },
    "owner": "umer.farooq"
  }
}
