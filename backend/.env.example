PORT=5000
NODE_ENV=development

# Postgres connection string (use Render's External Database URL for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/intharoute

# Signs access tokens. At least 32 random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional token lifetimes (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Admin account created by `npm run seed:admin` (public signup can never create an admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Set to true on hosts without a shell (e.g. Render free plan): on start the server
# applies pending migrations and seeds the admin if ADMIN_EMAIL/ADMIN_PASSWORD are set.
AUTO_MIGRATE=false

# Receipt scanning (OCR). Get a key at https://aistudio.google.com/apikey
# Without it, "Scan receipt" answers "Receipt scanning is not set up yet".
GEMINI_API_KEY=
# Models are raced fastest-first; if one fails the next starts at once, and if one is slow
# the next starts after GEMINI_HEDGE_MS. Leave empty for the tested default chain:
#   gemini-3-flash-preview:minimal,gemini-3.5-flash:minimal,gemini-flash-lite-latest:low,gemini-3.1-flash-lite:minimal
# Format: model[:thinking level], comma separated. Do not use gemini-2.5-* (shut down / closed to new users).
GEMINI_MODELS=
# Optional timings in ms (defaults shown)
GEMINI_HEDGE_MS=3500
GEMINI_ATTEMPT_TIMEOUT_MS=15000
GEMINI_TOTAL_TIMEOUT_MS=25000

# Optional: straight-line postcode distance x this factor approximates road miles (default 1).
DISTANCE_ROAD_FACTOR=1

# Optional: a driver with a recent GPS position is only offered pickups within this many miles (default 3).
DRIVER_OFFER_RADIUS_MILES=3

# File storage (KYC document photos). Leave S3_BUCKET empty to keep photos in Postgres.
# The bucket must block all public access; the server reads photos back for the admin.
S3_BUCKET=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: a folder inside the bucket (e.g. "production"), and a custom endpoint for
# S3-compatible storage such as Cloudflare R2 (leave empty for Amazon S3).
S3_KEY_PREFIX=
S3_ENDPOINT=

# Google Maps Platform (server key: Geocoding API + Routes API). Optional.
# With it: delivery addresses are pinned to the door, fees use road miles, drivers see a
# traffic-aware ETA and the road route. Without it: postcode centre and straight-line miles.
GOOGLE_MAPS_API_KEY=
# How often (seconds) a driver's live route/ETA is re-asked from Google (default 180).
ROUTE_REFRESH_SECONDS=180

# Push notifications go through Expo's push service; no key is needed.
# Only set EXPO_ACCESS_TOKEN if "Enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=
# PUSH_DISABLED=true turns sending off (e.g. on a test server).
PUSH_DISABLED=false

# Seconds a driver has to answer an offer before it goes to someone else (default 120).
OFFER_TIMEOUT_SECONDS=120
# Alert the restaurant and admins when nobody has taken a ready order after this many
# minutes, and when a collected order is still not delivered after this many minutes.
NO_DRIVER_ALERT_MINUTES=5
LATE_DELIVERY_MINUTES=45
