PORT=5000
NODE_ENV=development

# Postgres connection string (use Render's External Database URL for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/intharoute

# Signs access tokens. At least 32 random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional token lifetimes (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Admin account created by `npm run seed:admin` (public signup can never create an admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Set to true on hosts without a shell (e.g. Render free plan): on start the server
# applies pending migrations and seeds the admin if ADMIN_EMAIL/ADMIN_PASSWORD are set.
AUTO_MIGRATE=false

# Receipt scanning (OCR). Get a key at https://aistudio.google.com/apikey
# Without it, "Scan receipt" answers "Receipt scanning is not set up yet".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: straight-line postcode distance x this factor approximates road miles (default 1).
DISTANCE_ROAD_FACTOR=1
